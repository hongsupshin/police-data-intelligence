# Copy this file to .env and fill in your actual credentials

# Required: API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key

# Required: PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tji_data
DB_USER=your_username
DB_PASSWORD=your_password

# Optional: Logging (default: INFO)
# LOG_LEVEL=INFO

# Optional: Enrichment pipeline settings (all have defaults)
# ENRICHMENT_OUTPUT_DIR=output/enrichment
# ENRICHMENT_MAX_SEARCH_RESULTS=5
# ENRICHMENT_SEARCH_DEPTH=advanced
# ENRICHMENT_RELEVANCE_SCORE_THRESHOLD=0.5
# ENRICHMENT_FUZZY_MATCH_THRESHOLD=80
# ENRICHMENT_DATE_PROXIMITY_DAYS=3